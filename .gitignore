
# Terraform local provider files
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# AWS credentials
.aws/
credentials

# Local environment files
.env
.env.*

# Local Terraform CLI configuration
.terraformrc
terraform.rc
